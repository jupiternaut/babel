{
  "name": "@nimbalyst/babel",
  "version": "0.1.0-m0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Babel workbench M0: shared domain core, demo service, CLI, TUI, GUI, hooks",
  "bin": {
    "babel": "./bin/babel.mjs"
  },
  "scripts": {
    "server": "tsx src/server/main.ts",
    "cli": "tsx src/cli/main.ts",
    "tui": "tsx src/tui/main.ts",
    "gui": "vite --config src/gui/vite.config.ts",
    "test": "vitest run --environment node",
    "typecheck": "tsc --noEmit",
    "profile:ensure": "tsx scripts/ensure-profile.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
